<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab11.MainWindow"
        Title="BioLab QR Manager" Width="900" Height="600">

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Left" Width="300" Spacing="10">
            <TextBlock Text="Dodaj nową próbkę" FontSize="18" FontWeight="Bold"/>
            
            <TextBox Name="txtSearch" 
             Watermark="Szukaj po nazwie lub ID próbki..." 
             Margin="0,0,0,10"
             TextChanged="OnSearchTextChanged"/>
    
          
            <TextBox Name="txtSampleId" Watermark="ID Próbki (np. DNA-001)"/>
            <TextBox Name="txtName" Watermark="Nazwa próbki"/>
            
            <ComboBox Name="cbType" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="DNA"/>
                <ComboBoxItem Content="RNA"/>
                <ComboBoxItem Content="Białko"/>
                <ComboBoxItem Content="Inny"/>
            </ComboBox>
            
            <DatePicker Name="dpDate"/>
            <TextBox Name="txtDesc" Watermark="Opis/Uwagi" Height="80" TextWrapping="Wrap"/>
            
            <Button Content="Zapisz Próbkę" Click="OnSaveClick" 
                    HorizontalAlignment="Stretch" Background="DarkGreen" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Spacing="5">
    <Button Content="Edytuj wybraną" Click="OnEditLoadClick" Width="145" Background="Goldenrod"/>
    <Button Content="Usuń próbkę" Click="OnDeleteClick" Width="145" Background="Firebrick" Foreground="White"/>
</StackPanel>

<Button Content="Aktualizuj zmiany" Name="btnUpdate" Click="OnUpdateSaveClick" 
        HorizontalAlignment="Stretch" Background="DodgerBlue" Foreground="White" IsEnabled="False"/>
            <Separator Margin="0,10"/>
            
            <Button Content="Generuj Kod QR" Click="OnGenerateQrClick" 
        HorizontalAlignment="Stretch" Background="DarkBlue" Foreground="White"/>

        <TextBlock Text="Podgląd etykiety:" Margin="0,10,0,0" FontWeight="Bold"/>
          <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
         <StackPanel HorizontalAlignment="Center">
        <Image Name="imgQrCode" Width="150" Height="150" Margin="0,0,0,10"/>
        <TextBlock Name="lblQrSampleName" TextAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
    </StackPanel>
</Border>
            <Button Content="Zapisz jako PNG" Click="OnSavePngClick" 
        HorizontalAlignment="Stretch" Margin="0,5,0,0"
        Background="Orange" Foreground="Black"/>

            <Button Content="Drukuj etykietę" Click="OnPrintClick" 
        HorizontalAlignment="Stretch" Margin="0,5,0,0"
        Background="SteelBlue" Foreground="White"/>

        </StackPanel>

        <DataGrid Name="dgSamples" Margin="20,0,0,0" AutoGenerateColumns="True" IsReadOnly="True" />
    </DockPanel>
</Window>